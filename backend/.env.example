# ═══════════════════════════════════════════════════════════════
# PRODUÇÃO: Antes de deploy, verifique:
# 1. APP_ENV=production, APP_DEBUG=false
# 2. APP_KEY gerado (php artisan key:generate)
# 3. FRONTEND_URL com domínio real
# 4. DB credentials de produção
# 5. QUEUE_CONNECTION=database (ou redis)
# 6. MAIL configurado para envio real
# 7. Todas API keys (Infobip, Grok, ElevenLabs) configuradas
# ═══════════════════════════════════════════════════════════════

APP_NAME="BusinessCode"
APP_ENV=local
APP_KEY=
# IMPORTANT: keep APP_DEBUG=false in production. In local dev, override in your .env.
APP_DEBUG=false
APP_URL=http://localhost:8000

# Timezone — defaults to São Paulo (Brazil). MySQL session timezone is set
# to match (DB_TIMEZONE=-03:00) so created_at/updated_at and SMS/email body
# placeholders show local time. If you change APP_TIMEZONE, update DB_TIMEZONE
# to the matching offset.
APP_TIMEZONE=America/Sao_Paulo
DB_TIMEZONE=-03:00

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campaignai
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------
# SESSION & CACHE
# -----------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

# -----------------------------------------------------------------------
# QUEUE — retry_after alto para suportar jobs longos de campanha
# Use 'redis' em produção para melhor performance, 'database' para desenvolvimento
# -----------------------------------------------------------------------
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=3700
DB_QUEUE_RETRY_AFTER=3700

# -----------------------------------------------------------------------
# CORS / FRONTEND
# -----------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL_ALT=https://www.meusite.com

# -----------------------------------------------------------------------
# SANCTUM
# -----------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000

# -----------------------------------------------------------------------
# SUPERADMIN (usado pelo SuperAdminSeeder)
# -----------------------------------------------------------------------
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=secret123

# -----------------------------------------------------------------------
# INFOBIP
# -----------------------------------------------------------------------
INFOBIP_API_KEY=
INFOBIP_BASE_URL=api.infobip.com
INFOBIP_DEFAULT_SENDER=InfoSMS
INFOBIP_FROM_EMAIL=
INFOBIP_FROM_EMAIL_NAME=
INFOBIP_VOICE_LANGUAGE=pt
# Secret para validar webhooks de entrega (deixe vazio para desabilitar)
INFOBIP_WEBHOOK_SECRET=

# -----------------------------------------------------------------------
# GROK / xAI (geracao de conteudo IA)
# -----------------------------------------------------------------------
GROK_API_KEY=
GROK_MODEL=grok-beta

# -----------------------------------------------------------------------
# ELEVENLABS (TTS — campanhas de voz)
# -----------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# -----------------------------------------------------------------------
# RATE LIMITING (requisicoes por minuto por usuario)
# -----------------------------------------------------------------------
RATE_LIMIT_AI=10
RATE_LIMIT_AUDIO=5
RATE_LIMIT_CAMPAIGN_DISPATCH=20

# -----------------------------------------------------------------------
# BILLING — creditos por envio (padrao, sobrescrito pelos seeders)
# -----------------------------------------------------------------------
CREDITS_PER_SMS=1
CREDITS_PER_VOICE=5
CREDITS_PER_EMAIL=2
CREDITS_PER_AI_GENERATION=10

# -----------------------------------------------------------------------
# BUSINESS IDENTITY (substitui valores hardcoded em views/controllers)
# -----------------------------------------------------------------------
BUSINESS_COMPANY_NAME="BusinessCode"
BUSINESS_BRAND_NAME="BusinessCode"
BUSINESS_LEGAL_NAME=
BUSINESS_CNPJ=
BUSINESS_SUPPORT_EMAIL=
# Numero com DDI e DDD, somente digitos, ex: 5511999999999
BUSINESS_SALES_WHATSAPP=
BUSINESS_SITE_URL=
BUSINESS_DOCS_URL=
BUSINESS_ANNUAL_DISCOUNT=20
BUSINESS_PENDING_SUB_TIMEOUT_HOURS=24
BUSINESS_TRIAL_DAYS=0
BUSINESS_TERMS_VERSION=1.0.0
BUSINESS_PRIVACY_VERSION=1.0.0
# Ativar verificacao de email pos-registro (true em producao)
BUSINESS_REQUIRE_EMAIL_VERIFICATION=false

# -----------------------------------------------------------------------
# CAPTCHA (Cloudflare Turnstile)
# Deixe vazio para desabilitar (dev/staging). Em producao, configure ambos.
# -----------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# -----------------------------------------------------------------------
# OBSERVABILITY
# Install with: composer require sentry/sentry-laravel
# Deixe vazio para desabilitar. Em producao, aponte para seu projeto Sentry.
# -----------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# -----------------------------------------------------------------------
# MAIL
# -----------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------
# FILESYSTEM
# -----------------------------------------------------------------------
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------
# BROADCAST
# -----------------------------------------------------------------------
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------
# REDIS (opcional — para cache/queue em producao)
# -----------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------
# AWS S3 (opcional — para armazenar audios gerados)
# -----------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Messaging APIs
MESSAGING_IDEMPOTENCY_TTL_HOURS=24
MESSAGING_TRANSACTIONAL_EMAIL_CREDITS=0
MESSAGING_REFUND_ON_UNDELIVERABLE=false
# Hosts permitidos para audio_url em voice messages (casa por sufixo).
# Adicione seu CDN próprio: MESSAGING_AUDIO_URL_ALLOWLIST=s3.amazonaws.com,meu-cdn.com
MESSAGING_AUDIO_URL_ALLOWLIST=s3.amazonaws.com,storage.googleapis.com,firebasestorage.googleapis.com,r2.cloudflarestorage.com,supabase.co,vercel-storage.com,b-cdn.net,blob.core.windows.net,digitaloceanspaces.com,wasabisys.com,backblazeb2.com
# Se true, libera qualquer HTTPS público (só bloqueia IPs privados). Default false.
MESSAGING_AUDIO_URL_ALLOW_ANY=false
MESSAGING_QUIET_HOURS_DEFAULT_TZ=America/Sao_Paulo
MESSAGING_QUIET_HOURS_DEFAULT_START=22:00
MESSAGING_QUIET_HOURS_DEFAULT_END=08:00
MESSAGING_RATE_LIMIT_SMS=300
MESSAGING_RATE_LIMIT_VOICE=10
MESSAGING_RATE_LIMIT_EMAIL=120
INFOBIP_INBOUND_WEBHOOK_SECRET=

# Billing (BRL)
BILLING_OVERDUE_GRACE_DAYS=7
BILLING_OVERDUE_RETRY_HOUR=04
BILLING_MONTHLY_DISPATCH_HOUR=03
BILLING_CREDIT_LIMIT_WARNING_PCT=80
BILLING_DEFAULT_INCLUDED_BALANCE_CENTS=0
BILLING_MIGRATION_PRICE_CENTS=15
BILLING_BRL_ENABLED=true

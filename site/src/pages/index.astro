.ft-col a{display:block;font-size:.82rem;color:var(--muted);margin-bottom:7px;transition:color .15s}
.ft-col a:hover{color:var(--blue)}
.ft-bottom{margin-top:28px;padding-top:18px;border-top:1px solid var(--border);display:flex;justify-content:space-between;font-size:.72rem;color:var(--muted);flex-wrap:wrap;gap:8px}
@media(max-width:768px){.ft-grid{grid-template-columns:1fr 1fr}}
</style>

<script is:inline>
(function () {
  var state = { plans: [], identity: null, stats: null, pricing: [], cycle: 'monthly', annualDiscount: 20 };

  function formatBrl(v) { return Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 0 }); }
  function formatBrl2(v) { return Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

  function fetchJson(url) {
    return fetch(url, { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; });
  }

  function applyIdentity(identity) {
    if (!identity) return;
    if (identity.brand_name) {
      document.querySelectorAll('[data-brand="name"]').forEach(function (el) { el.textContent = identity.brand_name; });
      document.title = identity.brand_name + '® — Você lê, aprova, vai dormir.';
    }
    var copy = document.getElementById('footer-copyright');
    if (copy && identity.legal_name) {
      copy.insertAdjacentHTML('beforeend', ' &middot; ' + identity.legal_name + (identity.cnpj ? ' &middot; CNPJ ' + identity.cnpj : ''));
    } else if (copy && identity.cnpj) {
      copy.insertAdjacentHTML('beforeend', ' &middot; CNPJ ' + identity.cnpj);
    }
    var footerDocs = document.getElementById('footer-docs');
    if (footerDocs && identity.docs_url) {
      footerDocs.href = identity.docs_url;
      footerDocs.hidden = false;
    }
    var footerSupport = document.getElementById('footer-support');
    if (footerSupport && identity.support_email) {
      footerSupport.href = 'mailto:' + identity.support_email;
      footerSupport.textContent = identity.support_email;
      footerSupport.hidden = false;
    }
    if (identity.site_url) {
      var canonical = document.getElementById('canonical-link');
      if (canonical) canonical.href = identity.site_url;
    }
  }

  function applyStats(stats) {
    if (!stats || !stats.has_data) return;
    var parts = [];
    if (stats.total_dispatches) parts.push(Number(stats.total_dispatches).toLocaleString('pt-BR') + ' mensagens entregues');
    if (stats.delivery_rate !== null && stats.delivery_rate !== undefined) parts.push('Taxa: ' + stats.delivery_rate.toString().replace('.', ',') + '%');
    if (!parts.length) return;
    document.getElementById('hero-stat-text').textContent = parts.join(' · ');
    document.getElementById('hero-stat').hidden = false;

    var grid = document.getElementById('stat-grid');
    grid.innerHTML = '';
    if (stats.total_dispatches) grid.insertAdjacentHTML('beforeend', '<div class="stat-item"><div class="num">' + Number(stats.total_dispatches).toLocaleString('pt-BR') + '</div><div class="lab">Mensagens entregues</div></div>');
    if (stats.delivery_rate !== null && stats.delivery_rate !== undefined) grid.insertAdjacentHTML('beforeend', '<div class="stat-item"><div class="num">' + stats.delivery_rate.toString().replace('.', ',') + '%</div><div class="lab">Taxa de entrega</div></div>');
    if (stats.total_tenants) grid.insertAdjacentHTML('beforeend', '<div class="stat-item"><div class="num">' + Number(stats.total_tenants).toLocaleString('pt-BR') + '</div><div class="lab">Empresas ativas</div></div>');
    grid.insertAdjacentHTML('beforeend', '<div class="stat-item"><div class="num">' + (stats.channels_supported || 4) + '</div><div class="lab">Canais integrados</div></div>');
    document.getElementById('stat-bar').hidden = false;
  }

  function renderPlans() {
    var grid = document.getElementById('pricing-grid');
    if (!state.plans.length) {
      grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:var(--muted);font-size:.9rem">Os planos ainda estão sendo configurados. Volte em breve.</div>';
      return;
    }
    grid.innerHTML = '';
    var ordered = state.plans.slice().sort(function (a, b) {
      function rank(p) { return p.slug === 'enterprise' ? Infinity : (p.slug === 'free' ? -1 : Number(p.price_monthly)); }
      return rank(a) - rank(b);
    });
    ordered.forEach(function (plan) {
      var priceMonthly = Number(plan.price_monthly);
      var isFree = priceMonthly === 0;
      var isEnterprise = plan.slug === 'enterprise';
      var isPop = plan.slug === 'pro';
      var monthlyShown = state.cycle === 'annual' && plan.monthly_equivalent_annual ? plan.monthly_equivalent_annual : priceMonthly;
      var features = (plan.features && typeof plan.features === 'object') ? plan.features : {};
      var channels = features.channels || [];
      var li = [];
      li.push('<li><span class="ck">✓</span>' + (channels.length ? 'Canais: ' + channels.join(', ') : 'Canais múltiplos') + '</li>');
      li.push('<li><span class="ck">✓</span>' + (Number(plan.max_contacts) > 0 ? Number(plan.max_contacts).toLocaleString('pt-BR') + ' contatos' : 'Contatos ilimitados') + '</li>');
      var saldoBrl = 'R$ ' + (Number(plan.included_balance_cents || 0) / 100).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (!isEnterprise && !isFree) li.push('<li><span class="ck">✓</span>' + saldoBrl + ' de saldo/mês</li>');
      if (features.ai_chatbot_enabled) li.push('<li><span class="ck">✓</span>Chatbot IA 24/7</li>');
      if (features.funnels_enabled) li.push('<li><span class="ck">✓</span>Funis automáticos</li>');
      if (features.api_access) li.push('<li><span class="ck">✓</span>Acesso à API</li>');
      if (features.white_label) li.push('<li><span class="ck">✓</span>White-label</li>');

      var ctaHref;
      var ctaLabel;
      if (isEnterprise) {
        if (state.identity && state.identity.sales_whatsapp) {
          ctaHref = 'https://wa.me/' + state.identity.sales_whatsapp.replace(/\D/g, '') + '?text=' + encodeURIComponent(state.identity.sales_whatsapp_prompt || '');
        } else {
          ctaHref = '#pricing';
        }
        ctaLabel = 'Falar com vendas';
      } else if (isFree) { ctaHref = 'https://dash.businesscode.com.br/register'; ctaLabel = 'Criar conta grátis'; }
      else {
        ctaHref = 'https://dash.businesscode.com.br/plans/checkout/' + plan.slug + (state.cycle === 'annual' ? '?cycle=annual' : '');
        ctaLabel = 'Escolher ' + plan.name + ' →';
      }

      var annualNote = '';
      if (state.cycle === 'annual' && plan.price_annual) {
        annualNote = '<div style="font-size:.7rem;color:var(--muted);margin-top:-12px;margin-bottom:12px">Cobrado anualmente: R$ ' + formatBrl2(plan.price_annual) + '</div>';
      }

      var valBlock = isEnterprise
        ? '<div class="price-val"><span class="num">Sob consulta</span></div>'
        : '<div class="price-val">' +
            (isFree
              ? '<span class="num">Grátis</span>'
              : '<span class="cur">R$</span><span class="num">' + formatBrl(monthlyShown) + '</span><span class="per">/mês</span>') +
          '</div>';

      var crBlock = isEnterprise
        ? '<div class="price-cr">Saldo e limites customizados</div>'
        : (isFree
            ? '<div class="price-cr">' + saldoBrl + ' de saldo para testar</div>'
            : '<div class="price-cr">' + saldoBrl + ' de saldo/mês</div>');

      var card = '' +
        '<div class="price' + (isPop ? ' pop' : '') + '">' +
          '<div class="price-name">' + plan.name + '</div>' +
          valBlock +
          crBlock +
          annualNote +
          '<ul>' + li.join('') + '</ul>' +
          '<a href="' + ctaHref + '" class="cta ' + (isFree ? 'cta-ghost' : 'cta-main') + '">' + ctaLabel + '</a>' +
        '</div>';
      grid.insertAdjacentHTML('beforeend', card);
    });
  }

  function applyPlans(response) {
    if (!response) return;
    var data = Array.isArray(response) ? response : (response.data || []);
    state.plans = data;
    if (response.meta && response.meta.annual_discount_percent) {
      state.annualDiscount = response.meta.annual_discount_percent;
    }
    var hasAnnual = data.some(function (p) { return p.price_annual && Number(p.price_annual) > 0; });
    if (hasAnnual) {
      document.getElementById('cycle-toggle').hidden = false;
      var badge = document.getElementById('cycle-discount');
      badge.textContent = '-' + Math.round(state.annualDiscount) + '%';
      badge.hidden = false;
    }
    renderPlans();
  }

  function setupCycleToggle() {
    var btn = document.getElementById('cycle-btn');
    var knob = document.getElementById('cycle-knob');
    var labelM = document.getElementById('cycle-monthly-label');
    var labelA = document.getElementById('cycle-annual-label');
    if (!btn) return;
    btn.addEventListener('click', function () {
      state.cycle = state.cycle === 'monthly' ? 'annual' : 'monthly';
      knob.style.transform = state.cycle === 'annual' ? 'translateX(24px)' : 'translateX(0)';
      labelM.style.color = state.cycle === 'monthly' ? 'var(--white)' : 'var(--muted)';
      labelA.style.color = state.cycle === 'annual' ? 'var(--white)' : 'var(--muted)';
      renderPlans();
    });
  }

  function applyPricing(rates) {
    var row = document.getElementById('credit-rates');
    if (!row || !rates || !rates.length) return;
    function escHtml(s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    var crIcons = {
      email: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>',
      sms: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
      voice: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.97.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.84.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
      whatsapp_marketing: '<svg viewBox="0 0 360 362" fill="#25D366" aria-hidden="true"><path fill-rule="evenodd" d="M307.546 52.566C273.709 18.684 228.706.017 180.756 0 81.951 0 1.538 80.404 1.504 179.235c-.017 31.594 8.242 62.432 23.928 89.609L0 361.736l95.024-24.925c26.179 14.285 55.659 21.805 85.655 21.814h.077c98.788 0 179.21-80.413 179.244-179.244.017-47.898-18.608-92.926-52.454-126.807v-.008Zm-126.79 275.788h-.06c-26.73-.008-52.952-7.194-75.831-20.765l-5.44-3.231-56.391 14.791 15.05-54.981-3.542-5.638c-14.912-23.721-22.793-51.139-22.776-79.286.035-82.14 66.867-148.973 149.051-148.973 39.793.017 77.198 15.53 105.328 43.695 28.131 28.157 43.61 65.596 43.593 105.398-.035 82.149-66.867 148.982-148.982 148.982v.008Zm81.719-111.577c-4.478-2.243-26.497-13.073-30.606-14.568-4.108-1.496-7.09-2.243-10.073 2.243-2.982 4.487-11.568 14.577-14.181 17.559-2.613 2.991-5.226 3.361-9.704 1.117-4.477-2.243-18.908-6.97-36.02-22.226-13.313-11.878-22.304-26.54-24.916-31.027-2.613-4.486-.275-6.91 1.959-9.136 2.011-2.011 4.478-5.234 6.721-7.847 2.244-2.613 2.983-4.486 4.478-7.469 1.496-2.991.748-5.603-.369-7.847-1.118-2.243-10.073-24.289-13.812-33.253-3.636-8.732-7.331-7.546-10.073-7.692-2.613-.13-5.595-.155-8.586-.155-2.991 0-7.839 1.118-11.947 5.604-4.108 4.486-15.677 15.324-15.677 37.361s16.047 43.344 18.29 46.335c2.243 2.991 31.585 48.225 76.51 67.632 10.684 4.615 19.029 7.374 25.535 9.437 10.727 3.412 20.49 2.931 28.208 1.779 8.604-1.289 26.498-10.838 30.228-21.298 3.73-10.46 3.73-19.433 2.613-21.298-1.117-1.865-4.108-2.991-8.586-5.234l.008-.017Z" clip-rule="evenodd"/></svg>',
      ai_generation: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.5 2.5 13 8l5.5 1.5L13 11l-1.5 5.5L10 11 4.5 9.5 10 8z"/><path d="M19 4v3"/><path d="M20.5 5.5h-3"/></svg>'
    };
    row.innerHTML = rates.map(function (r) {
      var brl = 'R$ ' + (Number(r.sale_cents) / 100).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      var ic = crIcons[r.service] || '';
      return '<div class="cr"><div class="cr-ic">' + ic + '</div><div class="v">' + brl + '</div><div class="l">' + escHtml(r.label) + '</div></div>';
    }).join('');
    var sms = rates.filter(function (r) { return r.service === 'sms'; })[0];
    if (sms) { window.__smsRate = Number(sms.sale_cents) / 100; if (typeof window.recalcCalc === 'function') window.recalcCalc(); }
  }

  function boot() {
    document.getElementById('footer-year').textContent = new Date().getFullYear();
    setupCycleToggle();

    Promise.all([
      fetchJson('/api/v1/public/identity'),
      fetchJson('/api/v1/public/stats'),
      fetchJson('/api/v1/plans'),
      fetchJson('/api/v1/public/pricing')
    ]).then(function (results) {
      state.identity = results[0];
      state.stats = results[1];
      state.pricing = (results[3] && results[3].data) ? results[3].data : [];
      applyIdentity(state.identity);
      applyStats(state.stats);
      applyPlans(results[2]);
      applyPricing(state.pricing);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

  window.addEventListener('scroll', function () {
    document.getElementById('nav').classList.toggle('scrolled', window.scrollY > 60);
    var sticky = document.getElementById('sticky-cta');
    if (sticky) {
      var show = window.scrollY > window.innerHeight * 0.6;
      sticky.style.opacity = show ? '1' : '0';
      sticky.style.pointerEvents = show ? 'auto' : 'none';
      sticky.style.transition = 'opacity .25s ease';
      sticky.setAttribute('aria-hidden', show ? 'false' : 'true');
    }
  });

  // Count-up animation for testimonial revenue (Hopkins: numbers earn attention)
  (function setupCountUps(){
    var nodes = document.querySelectorAll('[data-countup]');
    if (!nodes.length) return;

    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function format(prefix, n) {
      return prefix + Math.round(n).toLocaleString('pt-BR');
    }
    function animate(el) {
      var target = parseInt(el.getAttribute('data-countup'), 10);
      var prefix = el.getAttribute('data-prefix') || '';
      if (!isFinite(target) || target <= 0) return;
      if (reduced) { el.textContent = format(prefix, target); return; }

      var duration = 1600;
      var start = null;
      function frame(ts) {
        if (start === null) start = ts;
        var elapsed = ts - start;
        var t = Math.min(elapsed / duration, 1);
        var eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
        el.textContent = format(prefix, target * eased);
        if (t < 1) requestAnimationFrame(frame);
        else el.textContent = format(prefix, target);
      }
      requestAnimationFrame(frame);
    }

    if (!('IntersectionObserver' in window)) {
      nodes.forEach(animate);
      return;
    }

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          animate(entry.target);
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.4 });

    nodes.forEach(function (el) { io.observe(el); });
  })();

  // Sticky promo bar with rolling 24h countdown + dismiss (Brunson: scarcity real, not fake)
  (function setupPromoBar(){
    var bar = document.getElementById('promo-bar');
    var time = document.getElementById('promo-time');
    var close = document.getElementById('promo-close');
    if (!bar || !time || !close) return;

    var DISMISS_KEY = 'bc:promoDismissedAt';
    var DISMISS_TTL_MS = 24 * 60 * 60 * 1000;
    var lastDismiss = Number(localStorage.getItem(DISMISS_KEY) || 0);
    if (lastDismiss && Date.now() - lastDismiss < DISMISS_TTL_MS) {
      bar.style.display = 'none';
      return;
    }

    document.body.classList.add('has-promo');

    function pad(n) { return String(n).padStart(2, '0'); }
    function tick() {
      var now = new Date();
      var endOfDay = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);
      var remaining = Math.max(0, endOfDay - now);
      var h = Math.floor(remaining / 3600000);
      var m = Math.floor((remaining % 3600000) / 60000);
      var s = Math.floor((remaining % 60000) / 1000);
      time.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
    }
    tick();
    setInterval(tick, 1000);

    close.addEventListener('click', function () {
      bar.style.display = 'none';
      document.body.classList.remove('has-promo');
      try { localStorage.setItem(DISMISS_KEY, String(Date.now())); } catch (e) {}
    });
  })();

  // Interactive credit calculator (Hopkins: especificidade + materialização do ROI)
  (function setupCalc(){
    var input = document.getElementById('calc-contacts');
    var cost = document.getElementById('calc-cost');
    var narrative = document.getElementById('calc-narrative');
    if (!input || !cost || !narrative) return;

    function parseContacts(raw) {
      var n = parseInt(String(raw).replace(/\D+/g, ''), 10);
      return isFinite(n) && n > 0 ? n : 0;
    }
    function formatBrl0(v) {
      return 'R$ ' + Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    }
    function narrativeFor(n, c) {
      if (n === 0) return 'Coloca um número aí em cima — vou te mostrar quanto custa em SMS, e quantos planos isso paga.';
      if (n <= 2000) return 'Se essa campanha converter só 2% num ticket de R$ 150, você fatura ' + formatBrl0(n * 0.02 * 150) + '. ROI de ' + Math.round((n * 0.02 * 150) / c) + 'x num único disparo.';
      if (n <= 15000) return 'Essa campanha sozinha paga ' + Math.floor(c / 219) + ' meses do Pro. E você ainda tem disparos sobrando inclusos no plano.';
      return 'Esse seria o custo se você disparasse pra todo mundo de uma vez. Mas você não vai — vai segmentar. É exatamente por isso que existe o dashboard de atribuição.';
    }
    function recalc() {
      var n = parseContacts(input.value);
      var rate = (typeof window.__smsRate === 'number' && window.__smsRate > 0) ? window.__smsRate : 0.08;
      var c = n * rate;
      var row1 = document.querySelector('.calc-result .row1');
      if (row1) row1.textContent = 'A R$ ' + rate.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' por SMS, sua próxima campanha custa';
      cost.textContent = formatBrl0(c);
      narrative.textContent = narrativeFor(n, Math.max(c, 1));
      // Format input with thousand separators while keeping caret usability
      var formatted = n > 0 ? n.toLocaleString('pt-BR') : '';
      if (input.value !== formatted) {
        input.value = formatted;
      }
    }
    window.recalcCalc = recalc;
    input.addEventListener('input', recalc);
    input.addEventListener('blur', recalc);
    recalc();
  })();
})();
</script>
</BaseLayout>
